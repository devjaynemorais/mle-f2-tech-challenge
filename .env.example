# MLflow
# Local: http://localhost:5000 | Docker Compose: http://mlflow:5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=recommendation_system

# Data paths (override defaults from params.yaml if needed)
DATA_RAW_PATH=data/raw
DATA_INTERIM_PATH=data/interim
DATA_PROCESSED_PATH=data/processed

# Reproducibility
RANDOM_STATE=42
TEST_SIZE=0.2

# Model
MODEL_TYPE=mlp

# API serving
API_HOST=0.0.0.0
API_PORT=8000

# AWS credentials (optional — only needed for DVC remote S3 and cloud deploy)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# DVC_REMOTE_URL=s3://your-bucket/dvc-remote
